# Copy to .env and adjust for local use. docker-compose.yml already sets sane
# in-compose defaults; this file is for running the jar directly (mvn spring-boot:run
# or java -jar) against a local/remote Postgres instead.

DATABASE_URL=jdbc:postgresql://localhost:5432/wallet
DATABASE_USER=wallet
DATABASE_PASSWORD=wallet

# token:userId,token:userId — the whole of this exercise's auth mechanism.
AUTH_TOKENS=dev-token-alice:alice,dev-token-bob:bob,dev-token-carol:carol,dev-token-dave:dave,dev-token-erin:erin

PORT=8080
